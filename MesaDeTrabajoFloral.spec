def _keep_entry(dest_name: str, src_name: str) -> bool:
    norm = (dest_name + "|" + src_name).replace("\\", "/").lower()
    return not any(tok in norm for tok in _UNUSED_QT_TOKENS)


a.binaries = [b for b in a.binaries if _keep_entry(b[0], b[1])]
a.datas = [d for d in a.datas if _keep_entry(d[0], d[1])]

