/* Base */


QWidget {
    background-color: #1a0f15;
    color: #fceeef;
    font-family: "Segoe UI", Inter, sans-serif;
}

/* Sidebar */
#Sidebar {
    background-color: #21171C;
    border-right: 0px solid;
}

#SidebarTitle {
    font-size: 18px;
    background-color: transparent;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #fceeef;
    padding-left: 8px;
    border-radius: 10px;
}

/* Botones del menú lateral */
QPushButton#NavButton {
    background-color: transparent;
    color: #fceeef;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: left;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background-color: #651f42;
    color: #fceeef;
}

QPushButton#NavButton:checked {
    background-color: #e38292;
    color: #1a0f15;
    font-weight: 600;

}

/* Área de contenido */
#ContentArea {
    background-color: #1a0f15;
}

#ViewTitle {
    font-size: 16px;
    font-weight: 600;
    color: #fceeef;
}

/* Zona Drag & Drop */
#DropZone {
    background-color: #311423;
    border: 1.5px dashed #e38292;
    border-radius: 10px;
    min-height: 140px;
}

#DropZone:hover {
    border: 3px dashed #e38292;
    background-color: #311423;
}

#DropZone[dragActive="true"] {
    border-color: #ffc4c2;
    background-color: #311423;
}

#DropZoneBadge {
    background-color: transparent;
    color: #fceeef;
    font-weight: 800;
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    max-width: 32px;
}

#DropZoneTitle {
    font-size: 14px;
    font-weight: 600;
    color: #fceeef;
    background-color: transparent;
}

#DropZoneHint {
    font-size: 12px;
    color: #fceeef;
    background-color: transparent;
}

/* Lista de archivos */
#FileList {
    background-color: #21171C;
    border: 0px solid #23272F;
    border-radius: 10px;
    padding: 6px;
}

#FileList::item {
    background-color: #651f42;
    color: #fceeef;
    border-radius: 10px;
    padding: 8px 12px;
    margin-bottom: 4px;
}

#FileList::item:hover {
    background-color: #311423;
}

#FileList::item:selected {
    background-color: #311423;
    color: #fceeef;
}

/* Botones de acción */
#PrimaryButton {
    background-color: #e38292;
    color: #1a0f15;
    border: none;
    border-radius: 10px;
    padding: 9px 20px;
    font-weight: 700;
    font-size: 15px;
}

#PrimaryButton:hover {
    background-color: #ffc4c2;
}

#SecondaryButton {
    background-color: transparent;
    color: #fceeef;
    border: 0px solid #2E3440;
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
    font-size: 15px;
}

#SecondaryButton:hover {
    background-color: #e38292;
    color: #1a0f15;
}

/* Barra de progreso */
#MergeProgressBar {
    border: 0px solid #1a0f15;
    border-radius: 4px;
    background-color: #1a0f15;
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: #1a0f15;
    height: 12px;
}

#MergeProgressBar::chunk {
    background-color: #e38292;
    border-radius: 3px;
}

/* Tarjeta de información de documento */
#InfoCard {
    background-color: #21171C;
    border: 0px solid #23272F;
    border-radius: 10px;
}

#InfoCardPrimary {
    font-size: 15px;
    background-color: #21171C;
    font-weight: 600;
    color: #fceeef;
}

#InfoCardSecondary {
    font-size: 13px;
    background-color: #21171C;
    color: #fceeef;
}

/* Campos de entrada de formulario */
#FieldLabel {
    font-size: 12px;
    font-weight: 500;
    color: #fceeef;
}

#RangeInput {
    background-color: #21171C;
    border: 0px solid #2E3440;
    border-radius: 10px;
    color: #fceeef;
    padding: 8px 12px;
    font-size: 13px;
}

#RangeInput:focus {
    border: 1px solid #e38292;
}

#RangeInput:disabled {
    background-color: #21171C;
    color: #fceeef;
    border-color: #1E222A;
}

#StatsSuccess {
    font-size: 12px;
    background-color: #21171C;
    font-weight: 600;
    color: #e38292;
    margin-top: 4px;
}